msgid "https://posimyth.com/"
msgstr ""

#: includes/abilities/auth/wdesignkit-login-status.php:13
msgid "Get WDesignKit Login Status"
msgstr ""

#: includes/abilities/auth/wdesignkit-login-status.php:14
msgid "Checks whether the user is logged in to WDesignKit cloud. Returns login status, email, token validity, expiry time, and widget credit limits. Cloud operations like pushing widgets to marketplace require login."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:13
msgid "Login to WDesignKit Cloud"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:14
msgid "Authenticates the user against the WDesignKit cloud using email and password, and stores the session token locally. Use remember_me: true for a 90-day session; false (default) for a 1-day session."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:66
msgid "Login to WDesignKit Cloud with API Key"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:67
msgid "Authenticates the user against the WDesignKit cloud using a personal API token (instead of email and password), and stores the session locally. Useful for automation and CI workflows."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:111
msgid "Login / Sign Up to WDesignKit Cloud via Google or Facebook"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:112
msgid "Completes a WDesignKit Google or Facebook OAuth login/signup using the state code produced after the user authorises in the OAuth browser popup. Covers Login with Google, Login with Facebook, Sign Up with Google, and Sign Up with Facebook — all share the same backend endpoint."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:158
msgid "Sign Up for WDesignKit Cloud"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:159
msgid "Creates a new WDesignKit cloud account with a full name, email address, and password, then stores the session token locally so cloud features are immediately available."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:210
msgid "WDesignKit Cloud Forgot Password"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:211
msgid "Sends a password reset email to the specified WDesignKit cloud account address. This is a read-only operation — no local session is modified."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:253
msgid "Logout from WDesignKit Cloud"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:254
msgid "Logs the currently authenticated user out of WDesignKit cloud. Deletes the local session transient, calls the cloud logout endpoint to invalidate the token, and clears the cached licence data."
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:289
msgid "Get WDesignKit Social Login URL"
msgstr ""

#: includes/abilities/auth/wdesignkit-login.php:290
msgid "Generates a Google or Facebook OAuth authorisation URL and a unique state token. Step 1 of social login: open the returned auth_url in a browser popup for the user to authorise, then pass the state to wdesignkit/social-login (Step 2) once the popup closes."
msgstr ""

#: includes/abilities/class-wdk-ability-main.php:304
#: includes/admin/class-wdkit-enqueue.php:410
#: includes/admin/notices/class-wdkit-deactivate-feedback.php:103
msgid "WDesignKit"
msgstr ""

#: includes/abilities/class-wdk-ability-main.php:305
msgid "Abilities for WDesignKit widget management and settings."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-browse-snippets.php:15
msgid "Browse WDesignKit Code Snippets"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-browse-snippets.php:16
msgid "Lists code snippets available in the WDesignKit public marketplace. Supports filtering by search keyword, category/term, tags, plugins, free/pro status, and snippet type. All filter operations (Apply, Update, Remove single, Clear all) are different argument combinations on this one call."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-delete-snippet.php:13
msgid "Delete WDesignKit Cloud Snippet"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-delete-snippet.php:14
msgid "Deletes a snippet from the WDesignKit cloud marketplace by its cloud snippet ID. This removes the snippet from the cloud only — the local nxt-code-snippet WordPress post (if any) is NOT affected. Requires cloud login and confirm: true."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-download-snippet.php:13
msgid "Download WDesignKit Marketplace Snippet"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-download-snippet.php:14
msgid "Downloads a code snippet from the WDesignKit marketplace and installs it as a local nxt-code-snippet WordPress post. Free snippets do not require login; pro snippets require cloud login and an active licence. Returns the new post ID on success."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-get-snippet-filter-options.php:17
msgid "Get WDesignKit Snippet Filter Options"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-get-snippet-filter-options.php:18
msgid "Returns the dynamic filter option values used by the code-snippet marketplace browse UI: category/term ids, plugin ids, and tag ids (with their display names). Use this to discover the valid ids to pass to wdesignkit/browse-snippets' category, plugins, and tags filters."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-get-snippet.php:13
msgid "Get WDesignKit Snippet Info"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-get-snippet.php:14
msgid "Returns the title and description of a locally stored code snippet by its WordPress post ID. Works with both post-based and file-based (Nexter Pro) snippet storage. No cloud login required."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-get-snippet.php:63
msgid "Get Existing WDesignKit Cloud Snippets"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-get-snippet.php:64
msgid "Fetches the current user's previously uploaded cloud snippets. Used when saving a snippet to check whether it already exists on the cloud and to obtain the cloud snippet ID for an update. Requires cloud login."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-list-local-snippets.php:13
msgid "List Local WDesignKit Code Snippets"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-list-local-snippets.php:14
msgid "Lists all locally installed code snippets. Supports both Nexter Pro file-based storage (WP_CONTENT_DIR/nexter-snippet-data/) and legacy WordPress post-based storage. Returns each snippet's ID, name, type, status, and storage type. The returned file_id or post_id can be used with wdesignkit/get-snippet-info, wdesignkit/save-snippet, and wdesignkit/update-snippet-details. No cloud login required."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-my-snippets.php:13
msgid "Get My WDesignKit Snippets"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-my-snippets.php:14
msgid "Lists the code snippets the current user has uploaded to the WDesignKit cloud marketplace. Supports search and pagination. Requires cloud login."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-my-snippets.php:66
msgid "Get My WDesignKit Favourite Snippets"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-my-snippets.php:67
msgid "Lists the code snippets the current user has marked as favourites on the WDesignKit cloud marketplace. Supports search and pagination. Requires cloud login."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-my-snippets.php:119
msgid "Favourite / Unfavourite WDesignKit Snippet"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-my-snippets.php:120
msgid "Marks or unmarks a WDesignKit marketplace snippet as a favourite for the current user. Requires cloud login."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-save-snippet.php:13
msgid "Save / Upload WDesignKit Snippet to Cloud"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-save-snippet.php:14
msgid "Reads a local nxt-code-snippet WordPress post by its post ID, packages all its meta fields, and uploads the snippet to the WDesignKit cloud marketplace. Use stype \"new\" for a first-time upload or \"existing\" with a snippet_id to update a previously uploaded snippet. Requires cloud login."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-save-snippet.php:93
msgid "Update WDesignKit Local Snippet Details"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-save-snippet.php:94
msgid "Updates the title and/or description of a local code snippet. Works with both Nexter Pro file-based storage (provide file_id) and legacy WordPress post-based storage (provide post_id). This is a local-only operation — no cloud call is made. To sync the updated details to the cloud, follow up with wdesignkit/save-snippet using stype \"existing\"."
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-snippet-kit.php:13
msgid "Get WDesignKit Snippet Kit"
msgstr ""

#: includes/abilities/code-snippets/wdesignkit-snippet-kit.php:14
msgid "Fetches individual code snippets inside a WDesignKit snippet kit (bundle). A kit is a collection of related snippets. Returns snippet summaries (id, name, description, type, free_pro) without the raw code body to stay within the 1 MB output limit. Use page/per_page to paginate large kits. No cloud login required."
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:17
msgid "Activate WDesignKit Licence"
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:18
msgid "Activates a licence key against the WDesignKit cloud API. On success the returned licence record is stored locally in the wdkit_licence_data option so licence-gated features are immediately available. Requires cloud login."
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:76
msgid "Delete WDesignKit Licence"
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:77
msgid "Deactivates and removes a licence key from the WDesignKit cloud. For the \"wdkit\" licence, the local wdkit_licence_data option is also deleted. Requires cloud login and confirm: true."
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:135
msgid "Sync WDesignKit Licence"
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:136
msgid "Refreshes a licence record by re-fetching its current status from the WDesignKit cloud API. Useful after a plan upgrade or after renewing an expired licence. Requires cloud login."
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:184
msgid "WDesignKit Licence Credit & Storage Overview"
msgstr ""

#: includes/abilities/licence/wdesignkit-licence.php:185
msgid "Returns a combined overview of the locally stored WDesignKit licence record (plan, expiry, status) plus current AI credit balance fetched from the cloud. Set refresh: true to fetch fresh credit data; omit it to use locally cached licence data only."
msgstr ""

#: includes/abilities/presets/wdesignkit-browse-presets.php:13
msgid "Browse WDesignKit Preset Templates"
msgstr ""

#: includes/abilities/presets/wdesignkit-browse-presets.php:14
msgid "Fetches a page of preset (marketplace) templates from the WDesignKit cloud. Provide a preset_id (the numeric widget/template category ID) to browse presets for a specific widget — see instructions for the full list of valid IDs. Supports the same filter knobs the WDK UI exposes — builder, free/pro, search keyword, key_words (categories/tags), and plugin id."
msgstr ""

#: includes/abilities/presets/wdesignkit-download-preset.php:13
msgid "Download WDesignKit Preset Template"
msgstr ""

#: includes/abilities/presets/wdesignkit-download-preset.php:14
msgid "Downloads a preset template's content from the WDesignKit cloud. For pro presets the corresponding pro plugin (THEPLUS_VERSION for Elementor or TPGBP_VERSION for Gutenberg) must be active. Set custom_meta: true to restore nxt-* post meta onto the current post when the response includes it."
msgstr ""

#: includes/abilities/settings/wdesignkit-design-templates-toggle.php:13
msgid "Get WDesignKit Design Template Toggle States"
msgstr ""

#: includes/abilities/settings/wdesignkit-design-templates-toggle.php:14
msgid "Returns the current visibility state for the WDesignKit template library and per-builder template sources: Elementor templates and Gutenberg templates."
msgstr ""

#: includes/abilities/settings/wdesignkit-design-templates-toggle.php:48
msgid "Toggle WDesignKit Design Template Visibility"
msgstr ""

#: includes/abilities/settings/wdesignkit-design-templates-toggle.php:49
msgid "Enables or disables the WDesignKit template library and per-builder template sources. Turning off a builder-specific toggle hides that builder's templates without disabling the builder itself. Only the keys you pass are changed."
msgstr ""

#: includes/abilities/settings/wdesignkit-features-manager-toggle.php:13
msgid "Get WDesignKit Feature Manager States"
msgstr ""

#: includes/abilities/settings/wdesignkit-features-manager-toggle.php:14
msgid "Returns the current enabled/disabled state for WDesignKit plugin features: widget builder master switch, template library master switch, code-snippet module, and debug/developer mode."
msgstr ""

#: includes/abilities/settings/wdesignkit-features-manager-toggle.php:48
msgid "Toggle WDesignKit Plugin Features"
msgstr ""

#: includes/abilities/settings/wdesignkit-features-manager-toggle.php:49
msgid "Enables or disables individual WDesignKit plugin features: the widget builder master switch, the template library master switch, the code-snippet module, and debug/developer mode. Only the keys you pass are changed."
msgstr ""

#: includes/abilities/settings/wdesignkit-remove-database.php:13
msgid "WDesignKit Remove Database"
msgstr ""

#: includes/abilities/settings/wdesignkit-remove-database.php:14
msgid "Manages the WDesignKit database-cleanup configuration and can execute an immediate cleanup. \"get\" reads the current config; \"configure\" saves which data should be removed on uninstall; \"execute\" runs the cleanup immediately. Destructive execute requires confirm: true; use dry_run: true to preview."
msgstr ""

#: includes/abilities/settings/wdesignkit-rollback.php:13
msgid "List WDesignKit Rollback Versions"
msgstr ""

#: includes/abilities/settings/wdesignkit-rollback.php:14
msgid "Fetches the list of stable previous WDesignKit plugin versions available for rollback from wordpress.org. Excludes beta, RC, trunk, and dev versions, and any version equal to or newer than the currently installed version."
msgstr ""

#: includes/abilities/settings/wdesignkit-rollback.php:50
msgid "Rollback WDesignKit to Previous Version"
msgstr ""

#: includes/abilities/settings/wdesignkit-rollback.php:51
msgid "Downgrades the WDesignKit plugin to a specified previous stable version using the WordPress Plugin Upgrader. The plugin is automatically re-activated after installation. This replaces the current plugin files and cannot be undone without a further rollback or update. Requires confirm: true."
msgstr ""

#: includes/abilities/settings/wdesignkit-settings.php:13
msgid "Get WDesignKit Settings"
msgstr ""

#: includes/abilities/settings/wdesignkit-settings.php:14
msgid "Gets all WDesignKit plugin settings including builder toggles (Elementor, Gutenberg, Bricks), template visibility, code snippet toggle, and debug mode."
msgstr ""

#: includes/abilities/settings/wdesignkit-settings.php:62
msgid "Update WDesignKit Settings"
msgstr ""

#: includes/abilities/settings/wdesignkit-settings.php:63
msgid "Updates WDesignKit plugin settings. You can toggle individual features like Elementor builder, Gutenberg builder, template library, code snippets, and debug mode."
msgstr ""

#: includes/abilities/settings/wdesignkit-white-label.php:13
msgid "Get WDesignKit White Label Settings"
msgstr ""

#: includes/abilities/settings/wdesignkit-white-label.php:14
msgid "Returns the current WDesignKit white-label branding configuration: custom plugin name, description, developer name, website URL, logo URL, and visibility toggles for help link, news, license tab, and rollback tab."
msgstr ""

#: includes/abilities/settings/wdesignkit-white-label.php:49
msgid "Set WDesignKit White Label Settings"
msgstr ""

#: includes/abilities/settings/wdesignkit-white-label.php:50
msgid "Configures WDesignKit white-label branding. plugin_name is required. All other fields are optional; provided fields are merged with any existing white label configuration."
msgstr ""

#: includes/abilities/settings/wdesignkit-white-label.php:130
msgid "Reset WDesignKit White Label Settings"
msgstr ""

#: includes/abilities/settings/wdesignkit-white-label.php:131
msgid "Deletes the entire WDesignKit white-label configuration, restoring the default plugin branding. Requires confirm: true."
msgstr ""

#: includes/abilities/settings/wdesignkit-widget-builders-toggle.php:13
msgid "Get WDesignKit Widget Builder States"
msgstr ""

#: includes/abilities/settings/wdesignkit-widget-builders-toggle.php:14
msgid "Returns the current enabled/disabled state for each page builder integration: Elementor, Gutenberg, Gutenberg Core (native blocks), and Bricks. Also returns the master widget builder feature toggle."
msgstr ""

#: includes/abilities/settings/wdesignkit-widget-builders-toggle.php:48
msgid "Toggle WDesignKit Widget Builders"
msgstr ""

#: includes/abilities/settings/wdesignkit-widget-builders-toggle.php:49
msgid "Enables or disables individual page builder integrations (Elementor, Gutenberg, Gutenberg Core, Bricks) and the master widget builder feature toggle. Only the keys you pass are changed; omitted keys retain their current values."
msgstr ""

#: includes/abilities/templates/wdesignkit-ai-import-template.php:13
msgid "AI Import WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-ai-import-template.php:14
msgid "Calls the WDesignKit \"ai/template_import\" endpoint to generate AI-tailored template content for a given site profile. Returns the AI-rewritten copy that the caller can then feed into a builder. Maps to the \"Import Template — AI Import\" UI flow."
msgstr ""

#: includes/abilities/templates/wdesignkit-browse-kit-pages.php:13
msgid "Browse WDesignKit Kit Pages"
msgstr ""

#: includes/abilities/templates/wdesignkit-browse-kit-pages.php:14
msgid "Lists the individual pages contained in a WDesignKit marketplace website kit. Given a kit's container template_id (a type:websitekit record), returns each real page inside the kit with its own importable template id — the ids to feed into wdesignkit/import-template. Wraps the same \"kit_template\" cloud route the AI Kit import UI calls before importing."
msgstr ""

#: includes/abilities/templates/wdesignkit-browse-kits.php:17
msgid "Browse WDesignKit Marketplace Kits"
msgstr ""

#: includes/abilities/templates/wdesignkit-browse-kits.php:18
msgid "Searches and lists full-site Website Kits available in the WDesignKit public marketplace (the \"AI Kits\" collection). Supports keyword search plus category, builder, free/pro and pagination filters, and returns each kit's id, title and thumbnail. Feed a returned kit id into wdesignkit/browse-kit-pages to list that kit's importable pages."
msgstr ""

#: includes/abilities/templates/wdesignkit-browse-template-images.php:13
msgid "Browse WDesignKit Template Images"
msgstr ""

#: includes/abilities/templates/wdesignkit-browse-template-images.php:14
msgid "Fetches image options for a template section's image slots from the WDesignKit cloud image library. Returns a list of image URLs that can be passed as the images[] parameter in wdesignkit/ai-import-template. Requires cloud login."
msgstr ""

#: includes/abilities/templates/wdesignkit-find-template.php:13
msgid "Find WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-find-template.php:14
msgid "Searches the user's existing WDesignKit cloud templates by name keyword. Scope is the user's OWN saved templates only — this does NOT search the public marketplace / AI Kits, so marketplace kit names correctly return zero results here. Hits the \"existing_template\" endpoint (the same one update-template targets) so the IDs returned here can be passed straight to update-template, replace-template, remove-template, or import-template."
msgstr ""

#: includes/abilities/templates/wdesignkit-import-full-kit.php:17
msgid "Import Full WDesignKit Site Kit"
msgstr ""

#: includes/abilities/templates/wdesignkit-import-full-kit.php:18
msgid "Imports an entire website kit in one call: creates a WordPress page for every template in the kit, applies the relevant plugin/theme settings, enables required widgets, and sets the homepage/site name/tagline. DESTRUCTIVE by default — the reset_site step drafts every currently-published page; pass skip:[\"reset_site\"] to keep existing content. Get the kit_id from wdesignkit/browse-kits and the templates list from wdesignkit/browse-kit-pages."
msgstr ""

#: includes/abilities/templates/wdesignkit-import-template.php:13
msgid "Import WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-import-template.php:14
msgid "Downloads a saved or marketplace template's content from the WDesignKit cloud and returns it for insertion. Set with_dummy_data: true to fetch any post/page/product fixtures bundled with the template. Set custom_meta: true to restore nxt-* post meta onto the current post when the response includes it."
msgstr ""

#: includes/abilities/templates/wdesignkit-list-templates.php:147
msgid "List WDesignKit Templates"
msgstr ""

#: includes/abilities/templates/wdesignkit-list-templates.php:148
msgid "Browses the current user's saved WDesignKit cloud templates with optional filters. Scope is the user's OWN saved templates only — this does NOT list the public marketplace / AI Kits. Supports filtering by builder, search keyword, and template type. Use this for \"Browse Templates\", \"Apply Filter\", \"Update Filter\", \"Remove Single Filter\", and \"Clear All Filters\" — every filter operation is just a different combination of arguments."
msgstr ""

#: includes/abilities/templates/wdesignkit-remove-template.php:13
msgid "Remove WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-remove-template.php:14
msgid "Deletes a user-saved WDesignKit cloud template by ID. Requires confirm: true to execute. Use dry_run: true to preview which template would be deleted."
msgstr ""

#: includes/abilities/templates/wdesignkit-replace-template.php:13
msgid "Replace WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-replace-template.php:14
msgid "Replaces the contents of an existing user-saved cloud template with a new payload. Requires confirm: true. Behind the scenes this is an in-place update, but the ability is split out so it can carry the \"you are about to overwrite saved work\" guardrail. Use dry_run: true to preview the swap."
msgstr ""

#: includes/abilities/templates/wdesignkit-save-template-image.php:17
msgid "Set WDesignKit Template Thumbnail"
msgstr ""

#: includes/abilities/templates/wdesignkit-save-template-image.php:18
msgid "Uploads/sets the preview thumbnail image for a saved WDesignKit cloud template (works for both newly-saved and existing templates). Provide the template_id plus the image either as a URL (fetched and uploaded) or inline base64. Wraps the same save_images cloud endpoint the manual \"Upload image on server\" UI uses. Requires cloud login and a paid plan (the cloud rejects image uploads on free/subscriber accounts)."
msgstr ""

#: includes/abilities/templates/wdesignkit-save-template.php:13
msgid "Save WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-save-template.php:14
msgid "Saves a page builder layout to the user's WDesignKit cloud library as a new template. Provide the full builder data payload (JSON string for Gutenberg, base64-decoded Elementor export for Elementor) plus the source post_id so any nxt-* custom meta is captured alongside it."
msgstr ""

#: includes/abilities/templates/wdesignkit-template-plugins.php:17
msgid "Get WDesignKit Template Plugin IDs"
msgstr ""

#: includes/abilities/templates/wdesignkit-template-plugins.php:18
msgid "Lists the plugins and page builders the WDesignKit cloud knows about, with the numeric IDs used to tag a template's dependencies. Feed these IDs into wdesignkit/save-template's \"plugins\" input. Requires cloud login."
msgstr ""

#: includes/abilities/templates/wdesignkit-update-template.php:13
msgid "Update WDesignKit Template"
msgstr ""

#: includes/abilities/templates/wdesignkit-update-template.php:14
msgid "Updates an existing user-saved WDesignKit cloud template in place. Pass the template id (from list-templates or find-template) together with the new builder data. Optionally include a source post_id to refresh the nxt-* custom meta captured with the template."
msgstr ""

#: includes/abilities/utilities/wdesignkit-categories.php:13
msgid "List Widget Categories"
msgstr ""

#: includes/abilities/utilities/wdesignkit-categories.php:14
msgid "Lists all WDesignKit widget categories. Categories are used to organize widgets in the page builder panel."
msgstr ""

#: includes/abilities/utilities/wdesignkit-categories.php:63
msgid "Manage Widget Categories"
msgstr ""

#: includes/abilities/utilities/wdesignkit-categories.php:64
msgid "Add or remove widget categories in WDesignKit. Categories help organize widgets in the page builder panel."
msgstr ""

#: includes/abilities/utilities/wdesignkit-dependencies.php:13
msgid "Check Widget Dependencies"
msgstr ""

#: includes/abilities/utilities/wdesignkit-dependencies.php:14
msgid "Checks if required plugins and themes are installed and active for WDesignKit widgets. Verifies Elementor, The Plus Addons, Nexter, Bricks, and other dependencies."
msgstr ""

#: includes/abilities/utilities/wdesignkit-dependencies.php:60
msgid "Install Plugin Dependency"
msgstr ""

#: includes/abilities/utilities/wdesignkit-dependencies.php:61
msgid "Installs and activates a WordPress plugin from wordpress.org. Used to install required dependencies for WDesignKit widgets (e.g. Elementor, The Plus Addons)."
msgstr ""

#: includes/abilities/utilities/wdesignkit-get-abilities-guide.php:15
msgid "Get WDesignKit Abilities Guide"
msgstr ""

#: includes/abilities/utilities/wdesignkit-get-abilities-guide.php:16
msgid "Returns the full WDesignKit Abilities Guide (Markdown) — builder mapping, the create-code-verify widget workflow, the Nexter Blocks dedicated-ability rule, and safety rules for irreversible calls (dry_run before confirm, login before cloud, read before write). Call this BEFORE the first wdesignkit/* or nexter-blocks/* call in a session so subsequent calls follow the documented contracts."
msgstr ""

#: includes/abilities/utilities/wdesignkit-get-abilities-guide.php:66
msgid "WDesignKit abilities guide is missing or unreadable."
msgstr ""

#: includes/abilities/utilities/wdesignkit-list-abilities.php:13
msgid "List WDesignKit Abilities"
msgstr ""

#: includes/abilities/utilities/wdesignkit-list-abilities.php:14
msgid "Returns all registered WDesignKit abilities with their slugs, labels, descriptions, and input parameter summaries. Useful for discovering what operations are available."
msgstr ""

#: includes/abilities/widgets/wdesignkit-browse-widgets.php:15
msgid "Browse WDesignKit Marketplace Widgets"
msgstr ""

#: includes/abilities/widgets/wdesignkit-browse-widgets.php:16
msgid "Lists widgets available in the WDesignKit public marketplace. Supports the same filter knobs exposed in the WDK UI: builder, sub-builder, category, search keyword, free/pro, and pagination. All filter operations (Apply, Update, Remove single, Clear all) are just different argument combinations on this one call."
msgstr ""

#: includes/abilities/widgets/wdesignkit-check-widget-versions.php:13
msgid "Check WDesignKit Widget Versions"
msgstr ""

#: includes/abilities/widgets/wdesignkit-check-widget-versions.php:14
msgid "Queries the WDesignKit cloud for version information on one or more widgets identified by their marketplace record IDs (r_id). Returns the latest available version per widget so callers can detect which locally installed widgets are out of date."
msgstr ""

#: includes/abilities/widgets/wdesignkit-convert-widget.php:13
msgid "Convert WDesignKit Widget Builder"
msgstr ""

#: includes/abilities/widgets/wdesignkit-convert-widget.php:14
msgid "Converts a widget authored for one builder (e.g. Elementor) into a different builder (e.g. Gutenberg). NOTE: Automatic cross-builder conversion is not currently supported by the WDesignKit plugin. This ability returns a structured explanation and suggests the recommended manual workflow instead."
msgstr ""

#: includes/abilities/widgets/wdesignkit-create-widget.php:13
msgid "Create WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-create-widget.php:14
msgid "Creates a new widget for Elementor, Gutenberg, Gutenberg Core, or Bricks builder. Generates all required files (PHP, JSON config, CSS, JS) with proper boilerplate code. You can provide custom code for each file or use defaults."
msgstr ""

#: includes/abilities/widgets/wdesignkit-delete-widget.php:13
msgid "Delete WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-delete-widget.php:14
msgid "Soft-deletes a local WDesignKit widget by moving all its files to a recoverable trash folder. Requires confirm: true to execute. Use dry_run: true to preview what will be moved without making any changes."
msgstr ""

#: includes/abilities/widgets/wdesignkit-download-plugin.php:25
msgid "Download Widget as WordPress Plugin"
msgstr ""

#: includes/abilities/widgets/wdesignkit-download-plugin.php:26
msgid "Packages a local WDesignKit widget into a standalone, installable WordPress plugin ZIP and returns the download URL. Equivalent to the WP-admin \"Download WP Plugin\" popup. Requires cloud login."
msgstr ""

#: includes/abilities/widgets/wdesignkit-download-widget.php:13
msgid "Download WDesignKit Marketplace Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-download-widget.php:14
msgid "Downloads a widget by its numeric cloud ID and installs it in the local widget library — either a public marketplace widget, or one of the current user's own cloud widgets (including private, unpublished ones) when logged in. After a successful download the widget appears in wdesignkit/list-widgets. Maps to the \"Import Widget — Browse (Public Download)\" ability."
msgstr ""

#: includes/abilities/widgets/wdesignkit-duplicate-widget.php:13
msgid "Duplicate WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-duplicate-widget.php:14
msgid "Creates a copy of a local widget under a new name. All files (JSON, PHP, CSS, JS, image) are duplicated into a new folder. The JSON config is updated with a freshly generated widget_id and the new name. The duplicate is immediately visible in wdesignkit/list-widgets. Cloud records are NOT duplicated — the copy starts as a local-only widget."
msgstr ""

#: includes/abilities/widgets/wdesignkit-export-widget.php:13
msgid "Export WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-export-widget.php:14
msgid "Packages a local widget's JSON config (and thumbnail image if present) into a ZIP archive inside the same builder directory and returns the download URL. The resulting .zip can be imported on another site via wdesignkit/import-widget."
msgstr ""

#: includes/abilities/widgets/wdesignkit-get-widget.php:13
msgid "Get WDesignKit Widget Details"
msgstr ""

#: includes/abilities/widgets/wdesignkit-get-widget.php:14
msgid "Gets full details of a specific widget including its JSON config, PHP code, CSS styles, and JS scripts. Use list-widgets first to find the folder name and builder type."
msgstr ""

#: includes/abilities/widgets/wdesignkit-import-widget.php:13
msgid "Import WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-import-widget.php:14
msgid "Imports a widget into the local WDesignKit library from its JSON config object. Provide the full widget_data JSON (same structure as the .json file inside a .wdk ZIP export). The ability creates the correct builder folder, writes the JSON, and optionally downloads the widget thumbnail. Rejects imports when a widget with the same widget_id already exists."
msgstr ""

#: includes/abilities/widgets/wdesignkit-list-widgets.php:13
msgid "List WDesignKit Widgets"
msgstr ""

#: includes/abilities/widgets/wdesignkit-list-widgets.php:14
msgid "Lists all locally created widgets across all page builders (Elementor, Gutenberg, Gutenberg Core, Bricks). Shows widget name, builder type, version, status, and folder path."
msgstr ""

#: includes/abilities/widgets/wdesignkit-my-cloud-widgets.php:13
msgid "Get My WDesignKit Cloud Widgets"
msgstr ""

#: includes/abilities/widgets/wdesignkit-my-cloud-widgets.php:14
msgid "Lists the widgets the current user has pushed to their WDesignKit cloud account, including private ones that were never published to the public marketplace. Returns each widget's cloud id for use with wdesignkit/download-widget and wdesignkit/manage-workspace-widget. Supports search, builder filter, and pagination. Requires cloud login."
msgstr ""

#: includes/abilities/widgets/wdesignkit-push-widget.php:13
msgid "Push WDesignKit Widget to Cloud"
msgstr ""

#: includes/abilities/widgets/wdesignkit-push-widget.php:14
msgid "Uploads a local widget to the WDesignKit cloud marketplace. Reads the widget files from disk, packages them, and posts to the save_widget endpoint. Requires cloud login. After a successful push the cloud returns a marketplace record ID (r_id) which is written back to the local JSON so future version checks work correctly."
msgstr ""

#: includes/abilities/widgets/wdesignkit-toggle-widget.php:13
msgid "Activate WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-toggle-widget.php:14
msgid "Activates a deactivated widget so it gets loaded by the page builder. The widget files remain unchanged; this only updates the activation status."
msgstr ""

#: includes/abilities/widgets/wdesignkit-toggle-widget.php:60
msgid "Deactivate WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-toggle-widget.php:61
msgid "Deactivates a widget so it stops loading on the frontend. The widget files are preserved; this only updates the activation status. Useful for temporarily disabling a widget without deleting it."
msgstr ""

#: includes/abilities/widgets/wdesignkit-update-widget.php:13
msgid "Update WDesignKit Widget"
msgstr ""

#: includes/abilities/widgets/wdesignkit-update-widget.php:14
msgid "Updates an existing widget's PHP code, CSS styles, JS scripts, or JSON config metadata. Each code field is a FULL file replacement. Always use get-widget first to read the current code, then provide the complete updated content."
msgstr ""

#: includes/abilities/widgets/wdesignkit-widget-preview.php:13
msgid "WDesignKit Widget Preview"
msgstr ""

#: includes/abilities/widgets/wdesignkit-widget-preview.php:14
msgid "Creates (or reuses) a temporary WordPress page to preview a widget and returns its editor URL. For Elementor widgets the page opens in the Elementor canvas editor. For Gutenberg/gutenberg_core widgets the page opens in the block editor. No page is created for builder types other than those two."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace-items.php:13
msgid "Manage Template in WDesignKit Workspace"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace-items.php:14
msgid "Adds, removes, copies, or moves a cloud template within WDesignKit workspaces. Covers \"Add Template to Workspace\", \"Remove Template from Workspace\", \"Copy / Move Template in Workspace\", and \"Delete Template from Workspace\". Requires cloud login."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace-items.php:73
msgid "Manage Widget in WDesignKit Workspace"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace-items.php:74
msgid "Adds, removes, copies, or moves a cloud widget within WDesignKit workspaces. Covers \"Copy / Move Widget in Workspace\" and \"Delete Widget from Workspace\". Requires cloud login."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace-items.php:133
msgid "Manage Code Snippet in WDesignKit Workspace"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace-items.php:134
msgid "Adds, removes, copies, or moves a cloud code snippet within WDesignKit workspaces. Covers \"Copy / Move Code Snippet in Workspace\". Requires cloud login."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:13
msgid "Create WDesignKit Workspace"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:14
msgid "Creates a new cloud workspace in WDesignKit. A workspace is a shared environment for organising templates, widgets, and code snippets for team collaboration. Requires cloud login."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:63
msgid "Delete WDesignKit Workspace"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:64
msgid "Permanently deletes a WDesignKit cloud workspace by its workspace ID. Only the workspace container is removed — cloud templates, widgets, and snippets inside it are not deleted. Requires cloud login and confirm: true."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:112
msgid "Update WDesignKit Workspace"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:113
msgid "Updates the title and/or primary builder of an existing WDesignKit cloud workspace. Covers both \"Rename Workspace\" and \"Update Workspace Details\". Requires cloud login."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:164
msgid "Get WDesignKit Workspace Data"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:165
msgid "Retrieves full data for a specific WDesignKit cloud workspace including its templates, widgets, code snippets, member list, roles, and totals. Uses the v2 API. Requires cloud login."
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:209
msgid "Get WDesignKit Shared With Me"
msgstr ""

#: includes/abilities/workspace/wdesignkit-workspace.php:210
msgid "Lists templates and/or widgets that have been shared with the current user through WDesignKit cloud workspace collaboration. Supports type and builder filtering with pagination. Requires cloud login."
msgstr ""

