#. Plugin Name of the plugin
#: wdesignkit.php
msgid "WDesignKit - Elementor & Gutenberg Starter Templates, Patterns, Cloud Workspace & Widget Builder"
msgstr ""

#. Plugin URI of the plugin
#: wdesignkit.php
msgid "https://wdesignkit.com/"
msgstr ""

#. Description of the plugin
#: wdesignkit.php
msgid "Your All-in-One solution for effortless WordPress website creation and collaboration. With over 1,000+ Elementor and WordPress website templates, a library of 100+ pre-made widgets for Elementor, Gutenberg Blocks, and Bricks, along with a cloud workspace for collaboration and more."
msgstr ""

